{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicapi.local/schemas/capi.schema.json",
  "title": "CAPICAPI Capi/Product Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capi_id",
    "series_id",
    "name",
    "archetype",
    "rarity",
    "status",
    "colors",
    "filaments",
    "approved_for_production"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "capi_id": { "type": "string", "pattern": "^CAPI-S[0-9]{2}-[0-9]{3}$" },
    "series_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "name": { "type": ["string", "null"] },
    "archetype": { "type": ["string", "null"] },
    "rarity": { "type": ["string", "null"], "enum": ["COMMON", "UNCOMMON", "RARE", "EPIC", "LEGENDARY", "SECRET", "SHINY", null] },
    "status": {
      "type": "string",
      "enum": ["NOT_STARTED", "CONCEPT", "DESIGN_REVIEW", "DFM_REVIEW", "PRINT_TEST", "REVISION_REQUIRED", "APPROVED_FOR_PRODUCTION", "RETIRED", "BLOCKED"]
    },
    "base_model_version": { "type": ["string", "null"] },
    "model_revision": { "type": ["string", "null"], "pattern": "^CAPI-S[0-9]{2}-[0-9]{3}-M[0-9]{3}$" },
    "colors": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
    "filaments": { "type": "array", "items": { "type": "string" } },
    "material": { "type": ["string", "null"] },
    "print_profile": { "type": ["string", "null"] },
    "orientation": { "type": ["string", "null"] },
    "supports_required": { "type": ["boolean", "null"] },
    "support_material_g": { "type": ["number", "null"], "minimum": 0 },
    "infill_type": { "type": ["string", "null"] },
    "infill_percentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "layer_height_mm": { "type": ["number", "null"], "minimum": 0 },
    "print_time_minutes": { "type": ["number", "null"], "minimum": 0 },
    "model_material_g": { "type": ["number", "null"], "minimum": 0 },
    "purge_material_g": { "type": ["number", "null"], "minimum": 0 },
    "total_material_g": { "type": ["number", "null"], "minimum": 0 },
    "estimated_unit_cost": { "type": ["number", "null"], "minimum": 0 },
    "measured_unit_cost": { "type": ["number", "null"], "minimum": 0 },
    "failure_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "approved_for_production": { "type": "boolean" },
    "approval_date": { "type": ["string", "null"], "format": "date" },
    "drive_folder_id": { "type": ["string", "null"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
