{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicapi.local/schemas/model_revision.schema.json",
  "title": "CAPICAPI Model Revision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_revision_id", "capi_id", "revision_number", "status", "drive_assets"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "model_revision_id": { "type": "string", "pattern": "^CAPI-S[0-9]{2}-[0-9]{3}-M[0-9]{3}$" },
    "capi_id": { "type": "string", "pattern": "^CAPI-S[0-9]{2}-[0-9]{3}$" },
    "revision_number": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["CONCEPT", "DFM_REVIEW", "SLICER_REVIEW", "PRINT_TEST", "APPROVED", "REJECTED", "ARCHIVED", "BLOCKED"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "source_revision_id": { "type": ["string", "null"] },
    "design_notes": { "type": "array", "items": { "type": "string" } },
    "intended_orientation": { "type": ["string", "null"] },
    "color_count": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
    "supports_required": { "type": ["boolean", "null"] },
    "drive_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["drive_file_id", "asset_type"],
        "properties": {
          "drive_file_id": { "type": ["string", "null"] },
          "drive_path": { "type": ["string", "null"] },
          "asset_type": { "type": "string", "enum": ["REFERENCE", "MODEL", "SLICER", "RENDER", "PHOTO", "OTHER"] }
        }
      }
    }
  }
}
