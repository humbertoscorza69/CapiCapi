{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicapi.local/schemas/content_item.schema.json",
  "title": "CAPICAPI Content Item Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_id", "status", "source_assets", "capi_ids", "metrics"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "content_id": { "type": "string", "pattern": "^CONTENT-[0-9]{4}-[0-9]{6}$" },
    "status": { "type": "string", "enum": ["RAW", "INGESTED", "CLASSIFIED", "IDEA", "PROCESSED", "GENERATED", "REVIEW", "APPROVED", "SCHEDULED", "PUBLISHED", "ANALYZED", "REJECTED", "ARCHIVED", "BLOCKED"] },
    "source_assets": { "type": "array", "items": { "type": "string" } },
    "capi_ids": { "type": "array", "items": { "type": "string", "pattern": "^CAPI-S[0-9]{2}-[0-9]{3}$" } },
    "series_id": { "type": ["string", "null"], "pattern": "^S[0-9]{2}$" },
    "platform": { "type": ["string", "null"] },
    "content_type": { "type": ["string", "null"] },
    "hook_type": { "type": ["string", "null"] },
    "first_frame_type": { "type": ["string", "null"] },
    "reveal_time_seconds": { "type": ["number", "null"], "minimum": 0 },
    "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
    "audio": { "type": ["string", "null"] },
    "audio_trending_status": { "type": ["string", "null"] },
    "caption": { "type": ["string", "null"] },
    "cta": { "type": ["string", "null"] },
    "hashtags": { "type": "array", "items": { "type": "string" } },
    "creative_hypothesis": { "type": ["string", "null"] },
    "experiment_id": { "type": ["string", "null"], "pattern": "^EXP-[0-9]{4}-[0-9]{4}$" },
    "scheduled_at": { "type": ["string", "null"], "format": "date-time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "views_1h": { "type": ["integer", "null"], "minimum": 0 },
        "views_24h": { "type": ["integer", "null"], "minimum": 0 },
        "views_7d": { "type": ["integer", "null"], "minimum": 0 },
        "avg_watch_time_seconds": { "type": ["number", "null"], "minimum": 0 },
        "retention": { "type": ["number", "null"], "minimum": 0 },
        "completion_rate": { "type": ["number", "null"], "minimum": 0 },
        "rewatches": { "type": ["integer", "null"], "minimum": 0 },
        "likes": { "type": ["integer", "null"], "minimum": 0 },
        "comments": { "type": ["integer", "null"], "minimum": 0 },
        "shares": { "type": ["integer", "null"], "minimum": 0 },
        "saves": { "type": ["integer", "null"], "minimum": 0 },
        "profile_visits": { "type": ["integer", "null"], "minimum": 0 },
        "link_clicks": { "type": ["integer", "null"], "minimum": 0 },
        "conversions": { "type": ["integer", "null"], "minimum": 0 },
        "revenue_attributed": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "drive_folder_id": { "type": ["string", "null"] },
    "drive_asset_ids": { "type": "array", "items": { "type": "string" } }
  }
}
