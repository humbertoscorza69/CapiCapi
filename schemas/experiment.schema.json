{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicapi.local/schemas/experiment.schema.json",
  "title": "CAPICAPI Marketing Experiment Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "status", "hypothesis", "content_ids", "success_metrics"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "experiment_id": { "type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{4}$" },
    "status": { "type": "string", "enum": ["DRAFT", "RUNNING", "MEASURED", "ADOPTED", "REJECTED", "RETEST", "BLOCKED"] },
    "hypothesis": { "type": "string" },
    "content_ids": { "type": "array", "items": { "type": "string", "pattern": "^CONTENT-[0-9]{4}-[0-9]{6}$" } },
    "platforms": { "type": "array", "items": { "type": "string" } },
    "success_metrics": { "type": "array", "items": { "type": "string" } },
    "viral_score": { "type": ["number", "null"], "minimum": 0 },
    "commercial_score": { "type": ["number", "null"], "minimum": 0 },
    "decision": { "type": ["string", "null"], "enum": ["ADOPT", "REJECT", "REVISE_AND_RETEST", "COLLECT_MORE_DATA", "ESCALATE", null] },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
