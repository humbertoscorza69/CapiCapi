{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicapi.local/schemas/agent_event.schema.json",
  "title": "CAPICAPI Agent Run/Event Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "agent", "workflow", "started_at", "status", "inputs", "outputs", "artifacts", "retry_count"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[A-Z_]+-[0-9]{4}$" },
    "agent": { "type": "string" },
    "workflow": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "type": "string", "enum": ["STARTED", "PASS", "FAIL", "BLOCKED", "RETRYING", "NEEDS_HUMAN"] },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "reference"],
        "properties": {
          "artifact_type": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    },
    "model_provider": { "type": ["string", "null"] },
    "model_name": { "type": ["string", "null"] },
    "prompt_version": { "type": ["string", "null"] },
    "token_cost": { "type": ["number", "null"], "minimum": 0 },
    "api_cost": { "type": ["number", "null"], "minimum": 0 },
    "error_details": { "type": ["string", "null"] },
    "retry_count": { "type": "integer", "minimum": 0 },
    "human_decision": { "type": ["string", "null"], "enum": ["APPROVED", "REJECTED", "CHANGE_REQUESTED", null] }
  }
}
