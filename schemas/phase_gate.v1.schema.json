{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicapi.local/schemas/phase_gate.v1.schema.json",
  "title": "CAPICAPI Phase Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "phase_name",
    "state",
    "decision_date",
    "objectives",
    "required_artifacts",
    "acceptance_criteria",
    "unresolved_risks",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "phase_id": {
      "type": "string"
    },
    "phase_name": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PRESENT",
              "MISSING",
              "NEEDS_REVIEW",
              "APPROVED"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
