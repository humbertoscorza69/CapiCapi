{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capicapi.local/schemas/production_batch.schema.json",
  "title": "CAPICAPI Production Batch Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "status", "capi_id", "model_revision_id", "quantities"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "batch_id": { "type": "string", "pattern": "^BATCH-[0-9]{8}-[0-9]{4}$" },
    "status": { "type": "string", "enum": ["PLANNED", "PRINTING", "QC", "APPROVED", "REJECTED", "IN_INVENTORY", "SHIPPED", "ARCHIVED", "BLOCKED"] },
    "capi_id": { "type": "string", "pattern": "^CAPI-S[0-9]{2}-[0-9]{3}$" },
    "model_revision_id": { "type": "string", "pattern": "^CAPI-S[0-9]{2}-[0-9]{3}-M[0-9]{3}$" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "printed", "failed", "approved", "held_back", "sold"],
      "properties": {
        "planned": { "type": ["integer", "null"], "minimum": 0 },
        "printed": { "type": ["integer", "null"], "minimum": 0 },
        "failed": { "type": ["integer", "null"], "minimum": 0 },
        "approved": { "type": ["integer", "null"], "minimum": 0 },
        "held_back": { "type": ["integer", "null"], "minimum": 0 },
        "sold": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "drive_folder_id": { "type": ["string", "null"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
