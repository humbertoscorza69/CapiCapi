# CAPICAPI environment template
# Copy to .env locally. Do not commit .env or credential files.

# Google Drive OAuth client secret downloaded from Google Cloud Console.
CAPICAPI_GOOGLE_CREDENTIALS=integrations/google_drive/credentials.json

# Local OAuth token cache generated after first successful auth.
CAPICAPI_GOOGLE_TOKEN=integrations/google_drive/token.json

# Optional existing Drive folder ID. If omitted, sync.py can create/find a CAPICAPI root folder.
CAPICAPI_DRIVE_ROOT_FOLDER_ID=

# Optional: dry-run is default. Set explicit CLI flags instead of relying on env for writes.
CAPICAPI_ENV=local
